# Deployment identity (non-secret). deploy.sh supplies this value and requires 40 lowercase hex characters.
APP_VERSION=

# PostgreSQL database/user names are non-secret. The password is secret and has no production default.
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=

# Approved public GitHub identity. The optional token is a backend-only secret.
PORTFOLIO_GITHUB_USERNAME=BaptisteWetterwald
PORTFOLIO_GITHUB_TOKEN=

# SMTP is mandatory in the production Compose contract. Identities and credentials stay private.
PORTFOLIO_CONTACT_RECIPIENT=
PORTFOLIO_CONTACT_SENDER=
PORTFOLIO_CONTACT_SUBJECT_PREFIX=[Contact Portfolio]
PORTFOLIO_CONTACT_RATE_LIMIT_MAX_SUBMISSIONS=5
PORTFOLIO_CONTACT_RATE_LIMIT_WINDOW=15m
PORTFOLIO_CONTACT_RATE_LIMIT_MAX_CLIENTS=2048
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# Enable these only after the SMTP provider is provisioned and the operational trade-off is accepted.
SPRING_MAIL_TEST_CONNECTION=false
MANAGEMENT_HEALTH_MAIL_ENABLED=false
