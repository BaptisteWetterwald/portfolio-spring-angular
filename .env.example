POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio-local-password
POSTGRES_HOST_PORT=5432

BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=4000

# Approved public M11 GitHub identity.
PORTFOLIO_GITHUB_USERNAME=BaptisteWetterwald
# Optional backend-only token. It enables the GraphQL contribution calendar and higher REST limits.
PORTFOLIO_GITHUB_TOKEN=

# Contact uses metadata-only logging in local development. Production must use smtp.
PORTFOLIO_CONTACT_DELIVERY_MODE=log
PORTFOLIO_CONTACT_RECIPIENT=
PORTFOLIO_CONTACT_SENDER=
PORTFOLIO_CONTACT_SUBJECT_PREFIX=[Contact Portfolio]
PORTFOLIO_CONTACT_RATE_LIMIT_MAX_SUBMISSIONS=5
PORTFOLIO_CONTACT_RATE_LIMIT_WINDOW=15m
PORTFOLIO_CONTACT_RATE_LIMIT_MAX_CLIENTS=2048

# Required only when PORTFOLIO_CONTACT_DELIVERY_MODE=smtp.
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
# Optional startup connectivity check after SMTP configuration is provisioned.
SPRING_MAIL_TEST_CONNECTION=false
# Optional Actuator SMTP health check after the same configuration is provisioned.
MANAGEMENT_HEALTH_MAIL_ENABLED=false

# Keep none locally. Production may use native only behind the documented trusted Nginx boundary.
SERVER_FORWARD_HEADERS_STRATEGY=none
